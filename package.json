{
  "name": "vant",
  "version": "0.8.6",
  "description": "vant CLI - Persistent AI agent with generational memory transfer",
  "bin": {
    "vant": "bin/vant.js",
    "mcp": "bin/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaupin/vant.git"
  },
  "homepage": "https://github.com/dhaupin/vant#readme",
  "preferGlobal": true,
  "keywords": [
    "ai",
    "agent",
    "cli",
    "github",
    "stegoframe",
    "memory",
    "multi-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "vant Project <vant@example.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "js-yaml": "^4.1.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "test": "node bin/build-test.js",
    "sweep": "node test/run-all.js",
    "setup": "node bin/setup.js",
    "start": "node bin/start.js",
    "health": "node bin/health.js",
    "lint": "eslint lib/ test/",
    "lint:fix": "eslint lib/ test/ --fix",
    "lint:web": "eslint web/dashboard/src web/dashboard/test web/dashboard/functions web/relay/src web/relay/functions",
    "lint:docs": "node scripts/check-docs-style.js && node scripts/check-docs-links.js && node scripts/check-docs-frontmatter.js && node scripts/check-language.js && node scripts/check-docs-truthfulness.js",
    "lint:coverage": "node scripts/check-mcp-coverage.js && node scripts/check-cli-coverage.js",
    "lint:claims": "node scripts/check-fiction-signatures.js",
    "lint:dist": "node scripts/check-dist-lander.js",
    "lint:surface": "node scripts/check-surface-consistency.js",
    "lint:helpers": "node scripts/check-stateful-helpers.js && node scripts/check-bin-truthfulness.js",
    "lint:locks": "node scripts/audit-locks.js",
    "check": "for f in lib/*.js bin/*.js test/*.js; do node --check \"$f\" || exit 1; done && echo 'syntax OK'",
    "dev:stack": "node scripts/dev-stack.js",
    "pilot:mfg": "node scripts/pilot-mfg-line.js",
    "pilot:pods": "node scripts/pilot-two-pods.js",
    "pilot:relay": "node scripts/pilot-two-relays.js",
    "pilot:pairing-ride": "node scripts/pilot-pairing-ride.js",
    "pilot:keyless-ride": "node scripts/pilot-keyless-ride.js",
    "dev:dashboard-build": "npm --prefix web/dashboard run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "typescript": "5.8.3"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "bugs": {
    "url": "https://github.com/dhaupin/vant/issues"
  }
}
