# Brain (private - per user/agent)
models/private/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# State (in brain - removed states/ directory)
models/public/.state.json
models/public/repos/

# Runtime state files (explicit)
models/.resolution.json
models/.providers.json
models/state.json
models/**/.*.json
models/**/.*.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime state (dotfiles - generated at runtime)
models/private/**
.agent_tmp/
storage/
temp/

# Logs
*.log
npm-debug.log*

# Build
build/

# Dist is NOT ignored - it's part of the public release
# dist/

# Temp
*.tmp
temp/models/latent/*.vpatch

# Migration test fixture scratch (test/migrations.test.js)
.migration-fixture/
.migration-fixture-legacy-main/

# Snapshot test scratch + runtime point-in-time snapshots
.snapshot-scratch/
models/.snapshots/

# Runtime tmp-space data (myStuff dropbox etc. — per-runtime, not template)
models/tmp-space/

# QC drill scratch (real-tree migration drills)
.drill-*/

# Agent capability-probe scratch (sandbox gate tests, never tracked)
/private/

# scripts/ scratch (one-shot repair/probe scripts) - see scripts/.gitignore
# for the convention: underscore/tmp- prefixed tools stay untracked.
scripts/_*
scripts/tmp-*
scripts/*.local.js

# Lock files (brain + storage)
.lock-brain-token
.locks/

# Circuit breakers (runtime state)
.circuit*.json
models/latent/*.vpatch
models/latent/.*

# Geometry storage in brain (runtime-generated)
models/*/geometry

# Quasicrystal NSC9 runtime data
data/
config.ini

# NOTE: models/public/vant/boot/ contents (including <agent>-p_*.svg
# horcrux snapshots) are PUBLIC by design. The p_ convention embeds
# the password in the filename — the file IS the public artifact.
# See models/public/vant/boot/README.md. Do NOT gitignore them.
#
# Sidecar files (.manifest.json, .sha256) for snapshots are reproducible
# side-products of bin/snapshot.js — ignore them, keep only the .svg.
models/public/vant/boot/*-p_*.svg.manifest.json
models/public/vant/boot/*-p_*.svg.sha256
# Existing tracked public-template horcruxes (nova, scribe, hypha)
# stay tracked; new snapshots from bin/snapshot.js get tracked too.


# Backup files
*.bak
settings.ini
