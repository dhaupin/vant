# Brain (private - per user/agent)
models/private/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# State (in brain - removed states/ directory)
models/public/.state.json
models/public/repos/

# Runtime state files (explicit)
models/.resolution.json
models/.providers.json
models/state.json
models/**/.*.json
models/**/.*.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime state (dotfiles - generated at runtime)
models/private/**
.agent_tmp/
storage/
temp/

# Logs
*.log
npm-debug.log*

# Build
build/

# Dist is NOT ignored - it's part of the public release
# dist/

# Temp
*.tmp
temp/models/latent/*.vpatch

# Lock files (brain + storage)
.lock-brain-token
.locks/

# Circuit breakers (runtime state)
.circuit*.json
models/latent/*.vpatch
models/latent/.*

# Geometry storage in brain (runtime-generated)
models/*/geometry

# Quasicrystal NSC9 runtime data
data/
config.ini

# Brain horcrux snapshots (reproducible via bin/snapshot.js, may contain
# encrypted secrets; would balloon the repo). The script is the canonical
# artifact. The boot/ dir is otherwise empty so this is safe to ignore fully.
models/public/boot/


# Backup files
*.bak
