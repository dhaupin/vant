# Project npm config (web/home) - the root .npmrc law, mirrored here:
# when the Pages root directory is web/home, npm reads THIS file, not the
# repo root's. Same rationale (npm/cli#9787, the npm 10.x arborist
# optional-peer-set crash confirmed to turn into a clean install with
# this flag); lockfiles are complete, so npm ci is unaffected either way.
legacy-peer-deps=true
