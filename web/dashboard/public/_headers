# Cloudflare Pages static-asset headers. These apply to the built HTML,
# JS and CSS ONLY - Pages does not apply _headers to Functions responses,
# so /api/* keeps its own posture in code.
#
# The dashboard is an admin console behind an OTP login: it must never be
# framed (clickjacking a sign-in form is the realistic attack), and the
# Content-Security-Policy below is the real XSS backstop for the lander's
# owner-authored HTML lane.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # Report-Only first: it can never break the app, and violations show up
  # in the browser console / Pages logs.
  #   style-src needs 'unsafe-inline': the app sets 2 inline React styles
  #   and Vite emits none, so this is the whole requirement.
  #   script-src stays 'self': no inline scripts, no eval in the bundle.
  # DO NOT flip this to the enforcing Content-Security-Policy header as-is:
  # connect-src 'self' blocks the operator-entered pod endpoint lane
  # (src/api.ts execDoorDirect fetches <podEndpoint>/mcp/exec) and the
  # EventSource stream (src/frame/events.ts). Add that origin to
  # connect-src at deploy time, or leave this reporting.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'

# Hashed build assets are immutable: cache hard, and they need no policy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
