# Project npm config (root).
#
# legacy-peer-deps=true - the npm 10.x arborist optional-peer-set crash
# (npm/cli#9787, "Cannot read properties of null (reading 'edgesOut')" in
# #loadPeerSet / build-ideal-tree.js) fires under registry drift on npm
# 10.9.2-10.9.9 with peer blocks like @vitejs/devtools' four optional
# self-referential siblings plus a wildcard peer. Hosted builders still
# shipping npm 10.x are the exposed side (a Cloudflare Pages deploy of
# this repo crashed exactly there on npm@10.9.2 + node 20.20.0), and the
# issue confirms this flag turns the crash into a clean install.
# All four committed lockfiles install 0-error under both npm 10.9.x and
# npm 11 locally, so this knob only matters when a builder chooses to
# re-resolve; it never weakens a `npm ci` path that is already complete.
legacy-peer-deps=true
